{
  "env": {
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "rules": {
    "arrow-body-style": "warn",
    "eqeqeq": "warn",
    "semi": ["error", "never"],
    "quotes": ["warn", "single"],
    "curly": "warn"
  }
}
