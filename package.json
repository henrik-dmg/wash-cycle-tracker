{
  "name": "washing-machine-server",
  "version": "1.0.0",
  "description": "A utility website that runs locally to notify when to clean your washing machine",
  "main": "server.js",
  "scripts": {
    "prestart": "tsc",
    "start": "node distribution/server.js",
    "dev": "nodemon distribution/server.js",
    "ui": "browser-sync start --config bs-config.js"
  },
  "engines": {
    "node": "17.x"
  },
  "author": "Henrik Panhans",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/henrik-dmg/washing-machine-server.git"
  },
  "dependencies": {
    "bcrypt": "^5.0.1",
    "express": "^4.17.1",
    "express-session": "^1.17.2",
    "mongodb": "^4.1.3",
    "pug": "^3.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/express-session": "^1.17.4",
    "@types/node": "^16.11.6",
    "browser-sync": "^2.27.7",
    "nodemon": "^2.0.14",
    "typescript": "^4.4.4"
  }
}
