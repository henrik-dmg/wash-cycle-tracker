  "description": "A utility website that runs locally to notify when to clean your washing machine",
  "main": "server.js",
  "scripts": {
    "prestart": "tsc",
    "start": "node distribution/server.js",
    "dev": "nodemon distribution/server.js",
    "ui": "browser-sync start --config bs-config.js"
  },
  "engines": {
    "node": "17.x"
  },
  "author": "Henrik Panhans",
  "license": "MIT",
  "repository": {
    "type": "git",
