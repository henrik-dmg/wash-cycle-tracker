    "auth0": "^2.37.0",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-openid-connect": "^2.5.1",
    "mysql": "^2.18.1",
    "pug": "^3.0.2",
    "sass": "^1.43.4",
    "typescript": "^4.4.4"
  },
  "devDependencies": {
    "@types/auth0": "^2.34.6",
    "@types/express": "^4.17.13",
    "@types/node": "^16.11.6",
