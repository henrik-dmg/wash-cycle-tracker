generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Machine {
  id          Int               @id @default(autoincrement())
  name        String
  description String
  createdAt   DateTime          @default(now())
  users       UsersOnMachines[]
  actions     Action[]
}

model User {
  id              String            @id
  name            String
  UsersOnMachines UsersOnMachines[]
  actions         Action[]
}

model Action {
  id         Int      @id @default(autoincrement())
  date       DateTime @default(now())
  actionType String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  machine    Machine  @relation(fields: [machineId], references: [id])
  machineId  Int
}

model UsersOnMachines {
  machine    Machine  @relation(fields: [machineId], references: [id])
  machineId  Int
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  assignedAt DateTime @default(now())
  assignedBy String

  @@id([machineId, userId])
}
