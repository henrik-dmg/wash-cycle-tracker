generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Machine {
  id          Int               @id @default(autoincrement())
  name        String
  description String
  createdAt   DateTime          @default(now())
  // Price of one wash cycle in the minor unit of the currency (for example cents).
  costPerWash Int               @default(0)
  currency    String            @default("EUR")
  // Secret code in the invite link. Old rows get a code when a member opens the machine.
  inviteCode  String?           @unique
  users       UsersOnMachines[]
  actions     Action[]
}

model User {
  id              String            @id
  name            String
  UsersOnMachines UsersOnMachines[]
  actions         Action[]
}

model Action {
  id         Int      @id @default(autoincrement())
  date       DateTime @default(now())
  actionType String
  // Cost of this cycle at the time of the log, so a later price change does not change old statements.
  cost       Int      @default(0)
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  machine    Machine  @relation(fields: [machineId], references: [id])
  machineId  Int
}

model UsersOnMachines {
  machine    Machine  @relation(fields: [machineId], references: [id])
  machineId  Int
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  assignedAt DateTime @default(now())
  assignedBy String

  @@id([machineId, userId])
}
